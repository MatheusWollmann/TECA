# Copie para .env.local e preencha. NÃO commite .env.local.

# Supabase (obrigatório)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# PostHog (analytics de produto) — opcional; sem chave, o track() vira no-op
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Sentry (erros / traces) — opcional; sem DSN, captureError() só faz console.error
VITE_SENTRY_DSN=
